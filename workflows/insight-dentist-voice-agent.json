                  {
                      "parameters":  {
                                         "jsCode":  "// Build clinic appointment slots for the requested date.\n// Insight Dentist hours: Mon-Fri 08:00-17:00, lunch 13:00-14:00, 30-min slots.\n\nconst edit = $(\u0027Extract Tool Args\u0027).first().json;\nconst dateStr = edit.date; // expected YYYY-MM-DD\n\nconst openHour = 8;\nconst closeHour = 17;   // last slot starts before this hour\nconst slotMinutes = 30;\nconst lunchStart = 13;  // 13:00 - 14:00 closed\nconst lunchEnd = 14;\n\nif (!dateStr) {\n  return [{ json: { start: null, end: null, label: null } }];\n}\n\nconst slots = [];\nfor (let h = openHour; h \u003c closeHour; h++) {\n  if (h \u003e= lunchStart \u0026\u0026 h \u003c lunchEnd) continue;\n  for (let m = 0; m \u003c 60; m += slotMinutes) {\n    const hh = String(h).padStart(2, \u00270\u0027);\n    const mm = String(m).padStart(2, \u00270\u0027);\n    const startISO = `${dateStr}T${hh}:${mm}:00+02:00`;\n    const end = new Date(new Date(startISO).getTime() + slotMinutes * 60000);\n    slots.push({\n      start: startISO,\n      end: end.toISOString(),\n      label: `${hh}:${mm}`\n    });\n  }\n}\n\nreturn slots.map(s =\u003e ({ json: s }));"
                                     },
                      "id":  "49effb1f-d694-44cb-86ae-5a20e14bdfdf",
                      "name":  "Find Slots",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       224,
                                       0
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "// Remove any slot that overlaps an existing calendar event, then\n// build a natural-language reply for the voice agent.\n\nconst events = $(\u0027Get Events\u0027).all()\n  .map(e =\u003e e.json)\n  .filter(e =\u003e e \u0026\u0026 e.start);\n\nconst busy = events.map(e =\u003e {\n  const s = new Date(e.start.dateTime || e.start.date).getTime();\n  const en = new Date(e.end.dateTime || e.end.date).getTime();\n  return { s, en };\n});\n\nconst free = [];\nfor (const item of $input.all()) {\n  const slot = item.json;\n  if (!slot.start) continue;\n  const ss = new Date(slot.start).getTime();\n  const se = new Date(slot.end).getTime();\n  const overlap = busy.some(b =\u003e ss \u003c b.en \u0026\u0026 se \u003e b.s);\n  if (!overlap) free.push(slot.label);\n}\n\nconst edit = $(\u0027Extract Tool Args\u0027).first().json;\nconst toolCallId = edit.toolCallId;\nconst dateStr = edit.date;\n\nlet message;\nif (free.length === 0) {\n  message = `I\u0027m sorry, we\u0027re fully booked on ${dateStr}. Would another day work for you?`;\n} else {\n  const show = free.slice(0, 6);\n  message = `On ${dateStr} we have these times open: ${show.join(\u0027, \u0027)}. Which one works best for you?`;\n}\n\nreturn [{ json: { toolCallId, availableSlots: free, message } }];"
                                     },
