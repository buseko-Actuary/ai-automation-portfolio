                  {
                      "parameters":  {
                                         "jsCode":  "// Vapi sends the tool call payload with an args property whose name n8n\u0027s\n// expression sandbox refuses to read. Grab it here in plain JS instead.\nconst body = $input.first().json.body || {};\nconst call = ((body.message || {}).toolCalls || [])[0] || {};\nconst fn = call.function || {};\nconst argsKey = Object.keys(fn).find(k =\u003e k !== \u0027name\u0027);\nconst a = (argsKey ? fn[argsKey] : {}) || {};\n\n// Guard: the model has been known to invent dates. Flag anything in the past\n// so downstream can refuse instead of silently booking a dead appointment.\nconst today = new Date(new Date().toLocaleString(\u0027en-US\u0027, { timeZone: \u0027Africa/Lusaka\u0027 }));\ntoday.setHours(0, 0, 0, 0);\nlet isPast = false;\nif (a.date) {\n  const req = new Date(a.date + \u0027T00:00:00+02:00\u0027);\n  isPast = !isNaN(req.getTime()) \u0026\u0026 req \u003c today;\n}\n\nreturn [{\n  json: {\n    toolCallId: call.id || \u0027\u0027,\n    toolName: fn.name || \u0027\u0027,\n    name: a.name || \u0027\u0027,\n    patientType: a.patientType || \u0027\u0027,\n    reason: a.reason || \u0027\u0027,\n    date: a.date || \u0027\u0027,\n    time: a.time || \u0027\u0027,\n    phone: a.phone || \u0027\u0027,\n    email: a.email || \u0027\u0027,\n    isPast: isPast,\n    todayISO: today.toISOString().slice(0, 10)\n  }\n}];"
                                     },
                      "id":  "6da38fee-81b4-4e7d-b27b-251d089faa81",
                      "name":  "Extract Tool Args",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       -220,
                                       300
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "// Patient-facing confirmation SMS.\n//\n// HARD CONSTRAINT: must stay ONE segment. Tested 2026-09-06 on a Zambian handset:\n// a 2-segment message was silently dropped by the carrier while Twilio still reported\n// \"Delivered\"; the same content as 1 segment arrived. Twilio\u0027s trial prefix eats ~37 of\n// the 160 chars, so the body budget is ~120. Do not lengthen without retesting.\nconst a = $(\u0027Extract Tool Args\u0027).first().json;\n\nconst days   = [\u0027Sun\u0027,\u0027Mon\u0027,\u0027Tue\u0027,\u0027Wed\u0027,\u0027Thu\u0027,\u0027Fri\u0027,\u0027Sat\u0027];\nconst months = [\u0027Jan\u0027,\u0027Feb\u0027,\u0027Mar\u0027,\u0027Apr\u0027,\u0027May\u0027,\u0027Jun\u0027,\u0027Jul\u0027,\u0027Aug\u0027,\u0027Sep\u0027,\u0027Oct\u0027,\u0027Nov\u0027,\u0027Dec\u0027];\n\nconst d = new Date(a.date + \u0027T\u0027 + (a.time || \u002700:00\u0027) + \u0027:00+02:00\u0027);\nlet whenText = a.date + \u0027 \u0027 + a.time;\nif (!isNaN(d.getTime())) {\n  const lus = new Date(d.getTime() + 2 * 60 * 60 * 1000);\n  whenText = days[lus.getUTCDay()] + \u0027 \u0027 + String(lus.getUTCDate()).padStart(2, \u00270\u0027) +\n             \u0027 \u0027 + months[lus.getUTCMonth()] + \u0027 \u0027 + a.time;\n}\n\nlet firstName = (a.name || \u0027\u0027).trim().split(/\\s+/)[0] || \u0027there\u0027;\nif (firstName.length \u003e 12) firstName = firstName.slice(0, 12);\n\nconst BUDGET = 120;\nconst head = \u0027Insight Dentist: Hi \u0027 + firstName + \u0027, appt confirmed \u0027 + whenText + \u0027.\u0027;\nconst tails = [\n  \u0027 Unilus Hospital, Alick Nkhata Rd. Call to reschedule.\u0027,\n  \u0027 Unilus Hospital, Alick Nkhata Rd.\u0027,\n  \u0027 Unilus Hospital.\u0027,\n  \u0027\u0027\n];\nlet body = head;\nfor (const t of tails) {\n  if ((head + t).length \u003c= BUDGET) { body = head + t; break; }\n}\nif (body.length \u003e BUDGET) body = body.slice(0, BUDGET);\n\n// --- phone validation -------------------------------------------------------\n// A Zambian mobile is 9 national digits after the 260 country code (e.g. 966011223).\n// The agent has misheard numbers on live calls (an extra 0 crept in), producing an\n// unroutable REPLACE_WITH_PHONE2. Never guess a correction: flag it and skip the SMS,\n// so a bad number shows up in the logs instead of failing silently at Twilio.\nlet digits = (a.phone || \u0027\u0027).replace(/\\D/g, \u0027\u0027);\nif (digits.startsWith(\u002700\u0027)) digits = digits.slice(2);\nif (digits.startsWith(\u0027260\u0027)) digits = digits.slice(3);\nif (digits.startsWith(\u00270\u0027))   digits = digits.slice(1);\n\nconst valid = /^[79]\\d{8}$/.test(digits);   // Zambian mobiles: 9x/7x + 8 more digits\nconst to = valid ? \u0027+260\u0027 + digits : \u0027\u0027;\n\nreturn [{\n  json: {\n    smsTo: to,\n    smsBody: body,\n    bodyLen: body.length,\n    phoneValid: valid,\n    phoneRaw: a.phone || \u0027\u0027,\n    patient: a.name,\n    when: whenText\n  }\n}];"
                                     },
