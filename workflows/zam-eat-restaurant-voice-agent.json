                  {
                      "parameters":  {
                                         "jsCode":  "// Zam Eat service hours, Africa/Lusaka (+02:00).\n// Open every day 10:00 to 22:00. Kitchen stops one hour before closing, so the\n// last sitting is 90 minutes before close. These hours must stay in step with the\n// opening-hours line in the assistant prompt and the Nyanja script, or the agent\n// will quote one thing and offer another.\nconst a = $(\u0027Extract Tool Args\u0027).first().json;\nconst dateStr = a.date;\nif (!dateStr) return [{ json: { start: null, end: null, label: null } }];\n\nconst openHour = 10;\nconst closeHour = 22;\nconst lastSitting = closeHour - 1.5;\nconst slotMinutes = 30;\nconst tableMinutes = 90;\n\nconst slots = [];\nfor (let t = openHour; t \u003c= lastSitting; t += slotMinutes / 60) {\n  const h = Math.floor(t);\n  const m = Math.round((t - h) * 60);\n  const hh = String(h).padStart(2, \u00270\u0027);\n  const mm = String(m).padStart(2, \u00270\u0027);\n  const startISO = `${dateStr}T${hh}:${mm}:00+02:00`;\n  const end = new Date(new Date(startISO).getTime() + tableMinutes * 60000);\n  slots.push({ start: startISO, end: end.toISOString(), label: `${hh}:${mm}` });\n}\nreturn slots.map(s =\u003e ({ json: s }));"
                                     },
                      "id":  "6250c691-2474-4d31-bf97-ac12e0aea2b0",
                      "name":  "Build Sittings",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       820,
                                       140
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "// The dining room seats 40. Each existing reservation carries its party size in the\n// event title, so capacity is counted in covers rather than tables.\nconst CAPACITY = 40;\n\nconst events = $(\u0027Get Reservations\u0027).all().map(e =\u003e e.json).filter(e =\u003e e \u0026\u0026 e.start);\nconst booked = events.map(e =\u003e {\n  const s = new Date(e.start.dateTime || e.start.date).getTime();\n  const en = new Date(e.end.dateTime || e.end.date).getTime();\n  const m = (e.summary || \u0027\u0027).match(/\\((\\d+)\\s*guests?\\)/i);\n  return { s, en, covers: m ? Number(m[1]) : 2 };\n});\n\nconst a = $(\u0027Extract Tool Args\u0027).first().json;\nconst party = Number(a.guests) || 2;\n\nconst free = [];\nfor (const item of $input.all()) {\n  const slot = item.json;\n  if (!slot.start) continue;\n  const ss = new Date(slot.start).getTime();\n  const se = new Date(slot.end).getTime();\n  const taken = booked\n    .filter(b =\u003e ss \u003c b.en \u0026\u0026 se \u003e b.s)\n    .reduce((sum, b) =\u003e sum + b.covers, 0);\n  if (taken + party \u003c= CAPACITY) free.push(slot.label);\n}\n\nlet message;\nif (party \u003e= 11) {\n  message = `For a party of ${party} our events manager handles the booking. I can take your name and number and have them call you back today.`;\n} else if (free.length === 0) {\n  message = `I\u0027m sorry, we\u0027re fully booked on ${a.date}. Would another day work?`;\n} else {\n  const show = free.slice(0, 6);\n  message = `On ${a.date} we can seat ${party} at: ${show.join(\u0027, \u0027)}. Which suits you?`;\n}\n\nreturn [{ json: { toolCallId: a.toolCallId, availableTimes: free, message } }];"
                                     },
