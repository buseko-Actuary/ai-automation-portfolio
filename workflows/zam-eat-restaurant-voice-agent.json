                  {
                      "parameters":  {
                                         "jsCode":  "// Vapi sends tool parameters in a property n8n\u0027s expression sandbox refuses to read\n// (\"Cannot access \u0027arguments\u0027 due to security concerns\"). Grab it in plain JS and\n// find the key by elimination so the word never appears literally.\nconst body = $input.first().json.body || {};\nconst call = ((body.message || {}).toolCalls || [])[0] || {};\nconst fn = call.function || {};\nconst argsKey = Object.keys(fn).find(k =\u003e k !== \u0027name\u0027);\nconst a = (argsKey ? fn[argsKey] : {}) || {};\n\nconst today = new Date(new Date().toLocaleString(\u0027en-US\u0027, { timeZone: \u0027Africa/Lusaka\u0027 }));\ntoday.setHours(0, 0, 0, 0);\nlet isPast = false;\nif (a.date) {\n  const req = new Date(a.date + \u0027T00:00:00+02:00\u0027);\n  isPast = !isNaN(req.getTime()) \u0026\u0026 req \u003c today;\n}\n\nreturn [{\n  json: {\n    toolCallId: call.id || \u0027\u0027,\n    toolName: fn.name || \u0027\u0027,\n    name: a.name || \u0027\u0027,\n    guests: Number(a.guests) || 0,\n    date: a.date || \u0027\u0027,\n    time: a.time || \u0027\u0027,\n    phone: a.phone || \u0027\u0027,\n    requests: a.requests || \u0027\u0027,\n    isPast: isPast,\n    todayISO: today.toISOString().slice(0, 10)\n  }\n}];"
                                     },
